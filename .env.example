# ==============================================================
# Vyapar Bandhu - Environment Configurations (.env)
# ==============================================================
# Copy this file to '.env' and populate your specific API keys.
# ==============================================================

# ----------------- BACKEND CONNECTIVITY -----------------------
# URL to local or hosted Spring Boot REST API
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ----------------- LLM INFERENCE APIS -------------------------
# The AI Chatbot (AskBandhu) routes dynamically through either API.
# If both are missing, it falls back to a mocked local parser.

# OpenAI (GPT-4o-mini Engine)
VITE_OPENAI_API_KEY=sk-xxxx...

# Google Gemini (Gemini 1.5 Flash Engine)
# Get a key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=AIzaSy...

# ----------------- GOVERNMENT DATA PIPELINE -------------------
# To fetch Open Government Data (data.gov.in) into gov_statistics.json
# Run: DATA_GOV_IN_API_KEY=your_key node fetch_gov_data.cjs
# DATA_GOV_IN_API_KEY=your_gov_api_key
