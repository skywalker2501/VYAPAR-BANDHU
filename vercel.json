{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "vyapar-bandhu-api"
      }
    }
  ],
  "services": {
    "vyapar-bandhu-api": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "cd backend && ./gradlew build -x test"
    }
  }
}
